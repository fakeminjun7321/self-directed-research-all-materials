; 01_em_strict.mdp
; Purpose: refine the minimized Packmol-based configuration with stricter tolerance.

integrator              = steep
emtol                   = 500.0
emstep                  = 0.01
nsteps                  = 50000

nstlog                  = 500
nstenergy               = 500

cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.2
ewald-rtol              = 1.0e-5
fourierspacing          = 0.12
pme-order               = 4

vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

tcoupl                  = no
pcoupl                  = no

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-order             = 4
lincs-iter              = 1

continuation            = no
