; Exploratory NVT: initial-density sensitivity screen only.
; The runner replaces gen-seed with a candidate-specific fixed seed.

integrator              = md
dt                      = 0.001
nsteps                  = 100000       ; 100 ps

nstlog                  = 1000
nstenergy               = 1000
nstxout-compressed      = 1000
compressed-x-precision  = 1000

cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.2
ewald-rtol              = 1.0e-5
fourierspacing          = 0.12
pme-order               = 4

vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.5
ref-t                   = 298.0

pcoupl                  = no

gen-vel                 = yes
gen-temp                = 298.0
gen-seed                = 110102

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-order             = 4
lincs-iter              = 1

continuation            = no
comm-mode               = Linear
nstcomm                 = 100

