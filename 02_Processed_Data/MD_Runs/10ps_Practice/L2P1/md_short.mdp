integrator            = md
dt                    = 0.001
nsteps                = 10000

nstlog                = 500
nstenergy             = 500
nstxout-compressed    = 100

cutoff-scheme         = Verlet
rlist                 = 1.2
pbc                   = xyz

coulombtype           = PME
rcoulomb              = 1.2
ewald-rtol            = 1.0e-5
vdwtype               = Cut-off
rvdw                  = 1.2
DispCorr              = EnerPres

tcoupl                = V-rescale
tc-grps               = System
tau-t                 = 0.1
ref-t                 = 298.0

pcoupl                = no

gen-vel               = yes
gen-temp              = 298.0
gen-seed              = -1

constraints           = h-bonds
constraint-algorithm  = LINCS
continuation          = no
