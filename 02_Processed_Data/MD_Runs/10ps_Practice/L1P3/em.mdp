integrator            = steep
dt                    = 0.001
nsteps                = 5000
emtol                 = 1000

nstlog                = 500
nstxout-compressed    = 500

cutoff-scheme         = Verlet
rlist                 = 1.2
pbc                   = xyz

coulombtype           = PME
rcoulomb              = 1.2
ewald-rtol            = 1.0e-5
vdwtype               = Cut-off
rvdw                  = 1.2
DispCorr              = EnerPres

tcoupl                = no
pcoupl                = no

constraints           = h-bonds
constraint-algorithm  = LINCS
continuation          = no
