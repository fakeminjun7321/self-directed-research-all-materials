; 03_npt_500ps.mdp
; Purpose: equilibrate density and box length at 298 K and 1 bar.

integrator              = md
dt                      = 0.001
nsteps                  = 500000       ; 500 ps

nstlog                  = 1000
nstenergy               = 1000
nstxout-compressed      = 1000
compressed-x-precision  = 1000

cutoff-scheme           = Verlet
verlet-buffer-tolerance = 0.005
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.2
ewald-rtol              = 1.0e-5
fourierspacing          = 0.12
pme-order               = 4

vdwtype                 = Cut-off
rvdw                    = 1.2
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.5
ref-t                   = 298.0

pcoupl                  = C-rescale
pcoupltype              = isotropic
tau-p                   = 5.0
ref-p                   = 1.0
compressibility         = 4.5e-5

gen-vel                 = no

constraints             = h-bonds
constraint-algorithm    = LINCS
lincs-order             = 4
lincs-iter              = 1

continuation            = yes
comm-mode               = Linear
nstcomm                 = 100
